FROM python:3.12-slim

# Install system deps (libsndfile often needed for audio)
RUN apt-get update && apt-get install -y \
    curl git libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /workspace

# Copy configs and libs
COPY pyproject.toml uv.lock README.md ./
COPY libs/ ./libs/

# Sync root deps
RUN uv sync --frozen --no-install-project

COPY adapters/ ./adapters/

# Iterate through all subdirectories in adapters/ and run uv sync in each
# This bakes the environments into the image.
RUN for dir in adapters/*; do \
      if [ -d "$dir" ] && [ -f "$dir/pyproject.toml" ]; then \
        echo "Syncing adapter in $dir..."; \
        cd "$dir" && uv sync --frozen && cd ../..; \
      fi \
    done

# Copy src code
COPY src/ ./src/
# We do NOT copy adapters here because we mount the whole workspace in dev.
# In prod, you would COPY adapters/ ./adapters/ and run `uv sync` in each.

RUN uv sync --frozen

ENV PATH="/workspace/.venv/bin:$PATH"
ENV PYTHONPATH="/workspace/src:$PYTHONPATH"

