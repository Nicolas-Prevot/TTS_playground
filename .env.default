HF_CACHE_HOST_DIR=C:/Users/nicol/.cache/huggingface
#HF_CACHE_HOST_DIR=./checkpoints/hf_cache

# Container-side cache path
HF_CACHE_CONTAINER_DIR=/cache/hf

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_RESULT_EXPIRES=3600
CELERY_CONCURRENCY=1

# API
UVICORN_HOST=0.0.0.0
UVICORN_PORT=7000

# Runner behavior
RUNNER_REQUEST_TIMEOUT=1800
IDLE_SECS=180
EXIT_ON_IDLE=1